name: Verify Development Web Deployment Gate
run-name: Verify development web gate ${{ inputs.commit_sha }}

on:
  workflow_call:
    inputs:
      commit_sha:
        required: true
        type: string
      migration_version:
        required: true
        type: string
    outputs:
      receipt_b64:
        description: "Base64-encoded verified development web gate receipt"
        value: ${{ jobs.verify.outputs.receipt_b64 }}
  workflow_dispatch:
    inputs:
      commit_sha:
        description: "API commit already deployed and healthy"
        required: true
        type: string
      migration_version:
        description: "Applied migration version"
        required: true
        default: "20260711120000"
        type: string

permissions:
  contents: read

concurrency:
  group: verify-development-web-deployment-gate
  cancel-in-progress: false

jobs:
  migration:
    uses: ./.github/workflows/verify-dev-migration-history.yml
    with:
      commit_sha: ${{ inputs.commit_sha }}
      migration_version: ${{ inputs.migration_version }}
      artifact_name: web-gate-migration-${{ inputs.commit_sha }}
    secrets: inherit

  verify:
    needs: migration
    runs-on: [self-hosted, Linux, X64, gooes-dev-deploy]
    environment: development
    timeout-minutes: 30
    outputs:
      receipt_b64: ${{ steps.receipt.outputs.receipt_b64 }}
    env:
      GATE_ENVIRONMENT: development
      GATE_COMMIT_SHA: ${{ inputs.commit_sha }}
      GATE_MIGRATION_VERSION: ${{ inputs.migration_version }}
    steps:
      - name: Guard development runner
        run: |
          set -euo pipefail
          test "${RUNNER_NAME}" = "gooes-dev-vm-0-11"
          test -r /opt/gooes-dev/docker/.env.dev.db

      - name: Checkout verified commit
        uses: actions/checkout@v6
        with:
          ref: ${{ inputs.commit_sha }}
          clean: true

      - uses: actions/setup-node@v6
        with:
          node-version: "22"

      - uses: oven-sh/setup-bun@v2
        with:
          bun-version: "1.3.2"

      - name: Verify immutable inputs
        run: |
          set -euo pipefail
          node scripts/validate-web-gate-inputs.mjs \
            "${GATE_ENVIRONMENT}" "${GATE_COMMIT_SHA}" "${GATE_MIGRATION_VERSION}"
          test "$(git rev-parse HEAD)" = "${GATE_COMMIT_SHA}"
          test -f supabase/migrations/20260711120000_reserve_sms_verification_code.sql

      - name: Verify reusable development migration evidence
        env:
          MIGRATION_EVIDENCE_B64: ${{ needs.migration.outputs.evidence_b64 }}
        run: |
          set -euo pipefail
          test -n "${MIGRATION_EVIDENCE_B64}"
          printf '%s' "${MIGRATION_EVIDENCE_B64}" | base64 -d > migration-evidence.json
          node scripts/verify-dev-migration-evidence.mjs \
            migration-evidence.json development "${GATE_COMMIT_SHA}" "${GATE_MIGRATION_VERSION}"

      - name: Verify API revision and health
        env:
          GOOES_WEB_PROXY_SHARED_SECRET: ${{ secrets.GOOES_WEB_PROXY_SHARED_SECRET }}
        run: |
          set -euo pipefail
          test "${#GOOES_WEB_PROXY_SHARED_SECRET}" -ge 32
          test "$(docker inspect -f '{{index .Config.Labels "org.opencontainers.image.revision"}}' gooes-api-dev)" = "${GATE_COMMIT_SHA}"
          expected_secret_hash="$(printf '%s\n' "${GOOES_WEB_PROXY_SHARED_SECRET}" | sha256sum | awk '{print $1}')"
          actual_secret_hash="$(docker exec gooes-api-dev printenv GOOES_WEB_PROXY_SHARED_SECRET | sha256sum | awk '{print $1}')"
          test "${actual_secret_hash}" = "${expected_secret_hash}"
          curl -fsS https://api-dev.goodcms.cn/ >/dev/null
          probe_ip=192.0.2.230
          timestamp="$(date +%s)"
          signature="$(PROBE_IP="${probe_ip}" PROBE_TIMESTAMP="${timestamp}" node -e '
            const { createHmac } = require("node:crypto");
            process.stdout.write(createHmac("sha256", process.env.GOOES_WEB_PROXY_SHARED_SECRET)
              .update(`${process.env.PROBE_TIMESTAMP}.${process.env.PROBE_IP}`).digest("hex"));
          ')"
          response="$(curl -fsS -X POST \
            -H "x-gooes-client-ip: ${probe_ip}" \
            -H "x-gooes-client-ip-timestamp: ${timestamp}" \
            -H "x-gooes-client-ip-signature: ${signature}" \
            https://api-dev.goodcms.cn/public/partner-applications/proxy-ip-check)"
          test "$(jq -r '.data.client_ip' <<< "${response}")" = "${probe_ip}"

      - name: Run isolated atomic reservation smoke
        env:
          SUPABASE_URL: ${{ secrets.SUPABASE_URL }}
          SUPABASE_PUBLISH: ${{ secrets.SUPABASE_PUBLISH }}
          SUPABASE_SERVICE_ROLE_KEY: ${{ secrets.SUPABASE_SERVICE_ROLE_KEY }}
        run: |
          set -euo pipefail
          corepack enable
          corepack prepare pnpm@10.33.0 --activate
          pnpm install --frozen-lockfile --filter @gooes/api... --filter @gooes/domain...
          cd apps/api
          bun src/scripts/web-deployment-gate-smoke.ts > ../../web-gate-smoke.json

      - name: Create immutable gate receipt
        id: receipt
        env:
          RECEIPT_COMMIT_SHA: ${{ inputs.commit_sha }}
          RECEIPT_MIGRATION_VERSION: ${{ inputs.migration_version }}
        run: |
          set -euo pipefail
          jq -n \
            --arg environment development \
            --arg sha "${RECEIPT_COMMIT_SHA}" \
            --arg migration "${RECEIPT_MIGRATION_VERSION}" \
            --slurpfile smoke web-gate-smoke.json \
            --slurpfile migrationEvidence migration-evidence.json \
            '{conclusion:"success", environment:$environment, commit_sha:$sha, migration_version:$migration} + $smoke[0] + $migrationEvidence[0]' \
            > web-deployment-gate-receipt.json
          node scripts/verify-web-gate-receipt.mjs \
            web-deployment-gate-receipt.json development "${RECEIPT_COMMIT_SHA}" "${RECEIPT_MIGRATION_VERSION}"
          receipt_b64="$(base64 -w0 web-deployment-gate-receipt.json)"
          printf 'receipt_b64=%s\n' "${receipt_b64}" >> "${GITHUB_OUTPUT}"

      - uses: actions/upload-artifact@v6
        with:
          name: web-deployment-gate-receipt
          path: web-deployment-gate-receipt.json
          if-no-files-found: error
          retention-days: 14
