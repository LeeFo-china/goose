name: Deploy

on:
  push:
    branches: [main, feature/customer]
    

jobs:
  deploy:
    runs-on: self-hosted    #使用自托管 runner
    
    steps:
      - name: Checkout
        uses: actions/checkout@v4
       
      - name: Deploy
        run: |
          # 2. 必须显式加载环境变量（关键：Self-hosted Runner 默认不带这些路径）
          export PATH="$HOME/.bun/bin:$PATH"
          export NVM_DIR="$HOME/.nvm"
          [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

          # 3. 使用环境变量 $GITHUB_WORKSPACE 自动定位目录
          #cd $GITHUB_WORKSPACE
          pwd
          # 4. 执行安装
          mkdir -p apps/api
          cp /home/github-deploy/_work/.env .env
          cp /home/github-deploy/_work/.env apps/api/.env
          pnpm install --frozen-lockfile --filter @gooes/api... --filter @gooes/domain...
          
          # 5. 优化 PM2 启动命令：
          # - 使用 reload 实现平滑重启
          # - 如果是第一次运行，reload 失败则执行 start
          API_CWD="$GITHUB_WORKSPACE/apps/api"
          API_ENTRY="$API_CWD/src/app.ts"
          CURRENT_API_CWD=$(pm2 jlist | node -e 'let s=""; process.stdin.on("data", d => s += d); process.stdin.on("end", () => { const app = JSON.parse(s).find((item) => item.name === "goose"); process.stdout.write(app?.pm2_env?.pm_cwd || ""); });')
          CURRENT_API_ENTRY=$(pm2 jlist | node -e 'let s=""; process.stdin.on("data", d => s += d); process.stdin.on("end", () => { const app = JSON.parse(s).find((item) => item.name === "goose"); process.stdout.write(app?.pm2_env?.pm_exec_path || ""); });')
          if [ "$CURRENT_API_CWD" = "$API_CWD" ] && [ "$CURRENT_API_ENTRY" = "$API_ENTRY" ]; then
            pm2 reload goose --update-env || pm2 restart goose --update-env
          else
            pm2 delete goose >/dev/null 2>&1 || true
            pm2 start "$API_ENTRY" --interpreter ~/.bun/bin/bun --name "goose" --cwd "$API_CWD" --update-env
          fi
