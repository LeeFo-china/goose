{
  "name": "gooes",
  "module": "apps/api/src/app.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "scripts": {
    "dev": "bun run api:dev",
    "start": "bun run api:start",
    "build": "bun run api:build",
    "api:dev": "cd apps/api && bun --watch src/app.ts",
    "api:start": "cd apps/api && bun src/app.ts",
    "api:build": "cd apps/api && bun build src/app.ts --outdir dist --target node",
    "api:typecheck": "pnpm --dir apps/api exec tsc -p tsconfig.json --noEmit",
    "admin:dev": "pnpm --dir apps/admin dev",
    "admin:build": "pnpm --dir apps/admin build",
    "admin:start": "pnpm --dir apps/admin start",
    "gen": "supabase gen types typescript --project-id unqhypivjkpwldhufpjc > apps/api/src/types/database.ts"
  }
}
