{
  "name": "gooes",
  "module": "apps/api/src/app.ts",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "pnpm": {
    "packageExtensions": {
      "@alicloud/openapi-core@*": {
        "dependencies": {
          "@alicloud/tea-typescript": "^1.8.0"
        }
      }
    }
  },
  "scripts": {
    "dev": "bun run api:dev",
    "start": "bun run api:start",
    "build": "bun run api:build",
    "api:dev": "cd apps/api && env -u SUPABASE_URL -u SUPABASE_PUBLISH -u SUPABASE_SERVICE_ROLE_KEY -u JWT_SECRET -u JWT_EXPIRES_IN -u AUTH_IDENTITY_SOURCE -u AUTH_PHONE_LOGIN_WITHOUT_CODE bun --env-file=.env --watch src/app.ts",
    "api:start": "cd apps/api && env -u SUPABASE_URL -u SUPABASE_PUBLISH -u SUPABASE_SERVICE_ROLE_KEY -u JWT_SECRET -u JWT_EXPIRES_IN -u AUTH_IDENTITY_SOURCE -u AUTH_PHONE_LOGIN_WITHOUT_CODE bun --env-file=.env src/app.ts",
    "api:worker:social-video": "cd apps/api && bun src/workers/social-video-transcription-worker.ts",
    "api:build": "cd apps/api && bun build src/app.ts --outdir dist --target node",
    "api:typecheck": "pnpm --dir apps/api exec tsc -p tsconfig.json --noEmit",
    "api:check-file-size": "bun scripts/check-api-file-size.ts",
    "api:check": "bun run api:typecheck && bun run api:build && bun run api:check-file-size",
    "api:construction-stage-check": "cd apps/api && bun src/scripts/construction-stage-consistency-check.ts",
    "api:property-location-coverage": "cd apps/api && bun src/scripts/property-location-coverage-check.ts",
    "api:property-location-backfill": "cd apps/api && bun --env-file=.env src/scripts/property-location-backfill.ts",
    "api:location-context-cleanup": "cd apps/api && bun --env-file=.env src/scripts/location-context-cleanup.ts",
    "api:tenant-address-coverage": "cd apps/api && bun --env-file=.env src/scripts/tenant-address-coverage-check.ts",
    "api:picture-library-import": "cd apps/api && bun --env-file=.env src/scripts/picture-library-import.ts",
    "check:permission-boundaries": "bun scripts/check-permission-boundaries.ts",
    "audit:supabase-writes": "bun scripts/audit-supabase-writes.ts",
    "seed:tenant:phase3": "bun scripts/seed-phase3-tenant-verification.ts",
    "verify:tenant:phase3": "bun scripts/verify-phase3-tenant-isolation.ts",
    "seed:tenant:phase5h": "bun scripts/seed-phase5h-tenant-verification.ts",
    "verify:tenant:phase5h": "bun scripts/verify-phase5h-tenant-isolation.ts",
    "h5:dev": "cd apps/h5 && bun run dev",
    "h5:build": "cd apps/h5 && bun run build",
    "admin:dev": "pnpm --dir apps/admin dev",
    "admin:dev:remote-api": "GOOES_API_BASE_URL=https://api-dev.goodcms.cn NEXT_PUBLIC_GOOES_API_BASE_URL=https://api-dev.goodcms.cn NEXT_PUBLIC_GOOES_H5_BASE_URL=https://h5-dev.goodcms.cn pnpm --dir apps/admin dev",
    "admin:build": "pnpm --dir apps/admin build",
    "admin:check": "pnpm --dir apps/admin check",
    "admin:check-file-size": "pnpm --dir apps/admin check:file-size",
    "admin:start": "pnpm --dir apps/admin start",
    "gen": "supabase gen types typescript --project-id fclnkyatvfvmzgzdqlba > apps/api/src/types/database.ts"
  }
}
