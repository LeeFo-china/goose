[Unit]
Description=Renew the www.goodcms.cn certificate in Supabase Nginx
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStartPre=/usr/bin/docker exec supabase-nginx rm -f /tmp/gooes-www-cert-renew-hook-failed
ExecStart=/usr/bin/docker exec supabase-nginx certbot renew --cert-name www.goodcms.cn --non-interactive --quiet --no-directory-hooks --deploy-hook "nginx -t && nginx -s reload || { touch /tmp/gooes-www-cert-renew-hook-failed; exit 1; }"
ExecStartPost=/usr/bin/docker exec supabase-nginx test ! -e /tmp/gooes-www-cert-renew-hook-failed
