NODE_ENV=production
PORT=3010

# Server-side Admin BFF -> API address inside the Docker network.
GOOES_API_BASE_URL=http://gooes-api:3000

# Browser-facing public URLs. These are also baked into the image during build.
NEXT_PUBLIC_GOOES_API_BASE_URL=https://api.goodcms.cn
NEXT_PUBLIC_GOOES_H5_BASE_URL=https://h5.goodcms.cn

# Compose image and port controls.
GOOES_ADMIN_IMAGE=useccr.ccs.tencentyun.com/america_goose/goose-admin:main
GOOES_ADMIN_BIND_HOST=127.0.0.1
GOOES_ADMIN_HOST_PORT=3010
GOOES_ADMIN_PORT=3010
