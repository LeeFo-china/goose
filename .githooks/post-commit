#!/usr/bin/env sh

node scripts/post-commit-rag-sync.mjs

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
LOG_FILE="$REPO_ROOT/.git/codegraph-sync.log"
NPX_BIN="$(command -v npx || true)"

[ -n "$NPX_BIN" ] || exit 0

(
  cd "$REPO_ROOT" || exit 0
  "$NPX_BIN" -y @colbymchenry/codegraph sync --quiet .
) >>"$LOG_FILE" 2>&1 &
