#!/usr/bin/env sh

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
BRANCH="$(git -C "$REPO_ROOT" branch --show-current 2>/dev/null || true)"

[ "$BRANCH" = "main" ] || exit 0
[ "${GOOES_RAG_SYNC:-}" = "0" ] && exit 0

RAG_DIR="${LIGHTRAG_MCP_DIR:-/Users/leefo/Public/work/mcp/rag}"

if [ ! -f "$REPO_ROOT/scripts/rag-sync-hook-runner.mjs" ]; then
  echo "[gooes-rag-sync] skip: hook runner not found at $REPO_ROOT/scripts/rag-sync-hook-runner.mjs"
  exit 0
fi

GIT_COMMON_DIR="$(git -C "$REPO_ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || exit 0
LOG_FILE="$GIT_COMMON_DIR/rag-sync.log"

cd "$REPO_ROOT" || exit 0
LIGHTRAG_MCP_DIR="$RAG_DIR" nohup node scripts/rag-sync-hook-runner.mjs --event post-merge --force >/dev/null 2>&1 </dev/null &

echo "[gooes-rag-sync] scheduled post-merge force sync; log: $LOG_FILE"

exit 0
