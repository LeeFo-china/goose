    "@fastify/autoload": "^6.3.1",
    "@fastify/multipart": "^10.0.0",
    "@gooes/domain": "workspace:*",
    "@supabase/supabase-js": "^2.100.0",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "fastify": "^5.8.4",
    "fastify-cli": "^7.4.1",
    "openai": "^6.34.0",
    "reflect-metadata": "^0.2.2",
