{
  "name": "@gooes/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "module": "src/app.ts",
  "scripts": {
    "dev": "bun --watch src/app.ts",
    "start": "bun src/app.ts",
    "worker:social-video": "bun src/workers/social-video-transcription-worker.ts",
    "storage:migration:dry-run": "bun src/scripts/storage-migration-dry-run.ts",
    "storage:migration:upload": "bun src/scripts/storage-migration-upload.ts",
    "storage:migration:verify": "bun src/scripts/storage-migration-verify.ts",
    "project-logs:images:backfill": "bun src/scripts/project-logs-image-backfill.ts",
    "build": "bun build src/app.ts --outdir dist --target node",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen": "supabase gen types typescript --project-id unqhypivjkpwldhufpjc > src/types/database.ts"
  },
  "dependencies": {
    "@alicloud/credentials": "^2.4.4",
    "@alicloud/dysmsapi20170525": "4.5.1",
