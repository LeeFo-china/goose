# 本机 API 开发环境示例。
# 实际密钥请从 dev 环境同步到 apps/api/.env，不要提交真实值。

NODE_ENV=development
PORT=3000
SERVICE_NAME=gooes-api-local
LOG_LEVEL=debug

SUPABASE_URL=https://your-dev-project.supabase.co
SUPABASE_PUBLISH=your-dev-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key

JWT_SECRET=replace-with-dev-jwt-secret
JWT_EXPIRES_IN=7d
APP_CONFIG_ENCRYPTION_KEY=replace-with-32-byte-dev-key

AUTH_IDENTITY_SOURCE=membership
AUTH_PHONE_LOGIN_WITHOUT_CODE=true

# COS / file storage. Fill with dev bucket credentials only.
PLATFORM_STORAGE_PROVIDER=tencent_cos
PLATFORM_COS_BUCKET=
PLATFORM_COS_REGION=
PLATFORM_COS_APP_ID=
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
PLATFORM_COS_SIGNED_URL_TTL_SECONDS=900
PLATFORM_COS_UPLOAD_USE_ACCELERATE=false
PLATFORM_COS_DIRECT_UPLOAD_VERIFY_HEAD=false
