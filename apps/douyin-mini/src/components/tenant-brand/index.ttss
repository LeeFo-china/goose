.brand { display: flex; min-height: 88rpx; align-items: center; gap: 20rpx; }
.brand-logo { width: 80rpx; height: 80rpx; flex: none; border-radius: 16rpx; background: #ece9e5; }
.brand-logo--fallback { display: flex; align-items: center; justify-content: center; font-size: 30rpx; font-weight: 600; }
.brand-logo--loading { animation: brand-pulse 1.4s ease-in-out infinite; }
.brand-copy { min-width: 0; }
.brand-name { overflow: hidden; color: #191817; font-size: 34rpx; font-weight: 650; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.brand-city { margin-top: 6rpx; color: #625f5b; font-size: 24rpx; line-height: 1.4; }
@keyframes brand-pulse { 50% { opacity: .5; } }
@media (prefers-reduced-motion: reduce) { .brand-logo--loading { animation: none; opacity: .65; } }
@import "../../styles/tokens.ttss";
