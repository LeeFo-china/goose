<view class="brand" aria-label="{{name}}">
  <view tt:if="{{loading}}" class="brand-logo brand-logo--loading"></view>
  <image tt:elif="{{logoUrl}}" class="brand-logo" src="{{logoUrl}}" mode="aspectFill" />
  <view tt:else class="brand-logo brand-logo--fallback">装</view>
  <view class="brand-copy">
    <view class="brand-name">{{loading ? '正在加载' : name}}</view>
    <view tt:if="{{city}}" class="brand-city">{{city}}服务</view>
  </view>
</view>
