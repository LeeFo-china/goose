.hero { position: relative; box-sizing: border-box; min-height: 360rpx; overflow: hidden; border-radius: 24rpx; background: #302b28; color: #fff; }
.hero-image, .hero-overlay { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; }
.hero-overlay { background: linear-gradient(90deg, rgba(20,17,15,.82), rgba(20,17,15,.3)); }
.hero-content { position: relative; z-index: 1; box-sizing: border-box; max-width: 560rpx; padding: 56rpx 40rpx; }
.hero-title { font-size: 44rpx; font-weight: 600; line-height: 1.35; }
.hero-subtitle { max-width: 480rpx; margin-top: 18rpx; color: rgba(255,255,255,.86); font-size: 26rpx; line-height: 1.6; }
.hero-action, .hero-retry { box-sizing: border-box; min-width: 224rpx; min-height: 88rpx; margin: 34rpx 0 0; padding: 0 28rpx; border-radius: 12rpx; color: #fff; font-size: 28rpx; font-weight: 600; line-height: 88rpx; }
.hero--loading, .hero--error { display: flex; align-items: center; justify-content: center; background: #ece9e5; color: #25211e; }
.hero-skeleton { width: calc(100% - 64rpx); height: 296rpx; border-radius: 18rpx; background: #dfdad5; animation: hero-pulse 1.4s ease-in-out infinite; }
.hero--error { flex-direction: column; padding: 40rpx; text-align: center; }
.hero--error .hero-title { font-size: 30rpx; }
.hero-retry { min-width: 176rpx; margin-top: 24rpx; background: #25211e; }
@keyframes hero-pulse { 50% { opacity: .52; } }
@media (prefers-reduced-motion: reduce) { .hero-skeleton { animation: none; opacity: .65; } }
