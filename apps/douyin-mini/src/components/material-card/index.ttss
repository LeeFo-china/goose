@import "../../styles/tokens.ttss";

.material-card {
  display: block;
  width: 100%;
  padding: 28rpx;
  text-align: left;
}

.material-card__content { min-width: 0; flex: 1; }

.material-card--flat {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid #dddad5;
  border-radius: 0;
  background: transparent;
}

.material-card__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.material-card__category,
.material-card__claimed {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #f5f5f3;
  color: #625f5b;
  font-size: 22rpx;
  line-height: 1.4;
}

.material-card__claimed {
  background: #eceae6;
  color: #191817;
}

.material-card__title {
  max-height: 84rpx;
  margin-top: 20rpx;
  overflow: hidden;
  color: #191817;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.4;
}

.material-card__summary {
  max-height: 108rpx;
  margin-top: 12rpx;
  overflow: hidden;
  color: #625f5b;
  font-size: 24rpx;
  line-height: 1.5;
}

.material-card__applicable {
  margin-top: 18rpx;
  color: #706c67;
  font-size: 22rpx;
  line-height: 1.5;
}

.material-card--flat .material-card__category,
.material-card--flat .material-card__claimed {
  padding: 0;
  border-radius: 0;
  background: transparent;
}

.material-card--flat .material-card__title { margin-top: 10rpx; font-size: 28rpx; }
.material-card--flat .material-card__summary { max-height: 36rpx; margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.material-card__arrow { width: 36rpx; flex: none; color: #85817c; font-size: 36rpx; line-height: 1; text-align: right; }
