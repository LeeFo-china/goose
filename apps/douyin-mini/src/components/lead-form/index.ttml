<form class="lead-form ui-card" conversion-target="{{douyinClueEnabled ? 1 : 0}}" clue-component-id="{{douyinClueComponentId}}" bindsubmit="onSubmit">
  <view class="required-fields">
    <view class="field-group">
      <view class="field-label">怎么称呼你 <text class="required" style="color: {{primaryColor}}">*</text></view>
      <input class="field-input ui-control {{fieldErrors.name ? 'ui-control--error' : ''}}" aria-label="称呼" data-field="name" maxlength="40" value="{{value.name}}" placeholder="例如：李先生" focus="{{focusedField === 'name'}}" disabled="{{submitting}}" bindinput="onInput" />
      <view tt:if="{{fieldErrors.name}}" class="ui-field-error" role="alert">{{fieldErrors.name}}</view>
    </view>
    <view tt:if="{{douyinClueEnabled}}" class="field-group">
      <view class="douyin-phone-note" role="note">
        提交时将使用抖音官方手机号授权，不需要填写短信验证码。
      </view>
    </view>
    <view tt:if="{{!douyinClueEnabled}}" class="field-group">
      <view class="field-label">联系电话 <text class="required" style="color: {{primaryColor}}">*</text></view>
      <input class="field-input ui-control {{fieldErrors.phone ? 'ui-control--error' : ''}}" aria-label="联系电话" data-field="phone" type="number" maxlength="11" value="{{value.phone}}" placeholder="请输入手机号" focus="{{focusedField === 'phone'}}" disabled="{{submitting}}" bindinput="onInput" />
      <view tt:if="{{fieldErrors.phone}}" class="ui-field-error" role="alert">{{fieldErrors.phone}}</view>
    </view>
    <view tt:if="{{!douyinClueEnabled}}" class="field-group">
      <view class="field-label">短信验证码 <text class="required" style="color: {{primaryColor}}">*</text></view>
      <sms-code-input value="{{value.sms_code}}" phone-ready="{{phoneReady && !submitting}}" sending="{{smsSending || submitting}}" cooldown="{{smsCooldown}}" focused="{{focusedField === 'sms_code'}}" error="{{fieldErrors.sms_code || ''}}" primary-color="{{primaryColor}}" bindchange="onSmsCodeChange" bindsend="onSendSms" />
      <view tt:if="{{fieldErrors.sms_code}}" class="ui-field-error" role="alert">{{fieldErrors.sms_code}}</view>
    </view>
    <view class="field-group">
      <view class="field-label">小区名称 <text class="required" style="color: {{primaryColor}}">*</text></view>
      <input class="field-input ui-control {{fieldErrors.community ? 'ui-control--error' : ''}}" aria-label="小区名称" data-field="community" maxlength="80" value="{{value.community}}" placeholder="例如：晴天花园" focus="{{focusedField === 'community'}}" disabled="{{submitting}}" bindinput="onInput" />
      <view tt:if="{{fieldErrors.community}}" class="ui-field-error" role="alert">{{fieldErrors.community}}</view>
    </view>
    <view class="field-group">
      <view class="field-label">期望量房日期 <text class="required" style="color: {{primaryColor}}">*</text></view>
      <picker mode="date" value="{{value.preferred_visit_date}}" start="{{minVisitDate}}" disabled="{{submitting}}" bindchange="onVisitDateChange">
        <view class="picker-control ui-control {{fieldErrors.preferred_visit_date ? 'ui-control--error' : ''}}" aria-label="期望量房日期">
          <text class="{{value.preferred_visit_date ? 'picker-value' : 'picker-placeholder'}}">{{value.preferred_visit_date || '请选择日期'}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
      <view tt:if="{{fieldErrors.preferred_visit_date}}" class="ui-field-error" role="alert">{{fieldErrors.preferred_visit_date}}</view>
    </view>
    <view class="field-group">
      <view class="field-label">期望量房时段 <text class="required" style="color: {{primaryColor}}">*</text></view>
      <view class="period-options" role="radiogroup" aria-label="期望量房时段">
        <button class="period-option ui-pressable {{value.preferred_visit_period === 'morning' ? 'period-option--active' : ''}}" hover-class="ui-pressable--pressed" style="{{value.preferred_visit_period === 'morning' ? 'border-color: ' + primaryColor + '; color: ' + primaryColor : ''}}" role="radio" aria-checked="{{value.preferred_visit_period === 'morning'}}" disabled="{{submitting}}" data-period="morning" bindtap="onVisitPeriodChange">上午</button>
        <button class="period-option ui-pressable {{value.preferred_visit_period === 'afternoon' ? 'period-option--active' : ''}}" hover-class="ui-pressable--pressed" style="{{value.preferred_visit_period === 'afternoon' ? 'border-color: ' + primaryColor + '; color: ' + primaryColor : ''}}" role="radio" aria-checked="{{value.preferred_visit_period === 'afternoon'}}" disabled="{{submitting}}" data-period="afternoon" bindtap="onVisitPeriodChange">下午</button>
        <button class="period-option ui-pressable {{value.preferred_visit_period === 'evening' ? 'period-option--active' : ''}}" hover-class="ui-pressable--pressed" style="{{value.preferred_visit_period === 'evening' ? 'border-color: ' + primaryColor + '; color: ' + primaryColor : ''}}" role="radio" aria-checked="{{value.preferred_visit_period === 'evening'}}" disabled="{{submitting}}" data-period="evening" bindtap="onVisitPeriodChange">晚间</button>
      </view>
      <view tt:if="{{fieldErrors.preferred_visit_period}}" class="ui-field-error" role="alert">{{fieldErrors.preferred_visit_period}}</view>
    </view>
  </view>

  <view tt:if="{{hasLinkedEstimate}}" class="estimate-card" role="note">
    <view class="estimate-label">已关联预算初算</view>
    <view class="estimate-number">预算编号 {{estimateNo}}</view>
    <view class="estimate-range">参考区间 {{estimateRange}}</view>
    <view class="estimate-note">量房申请会关联此预算结果，现场仍需确认施工范围。</view>
  </view>

  <button class="optional-toggle ui-pressable" hover-class="ui-pressable--pressed" aria-label="{{optionalDetailsExpanded ? '收起装修需求' : '展开装修需求'}}" disabled="{{submitting}}" bindtap="onToggleOptionalDetails">
    <view class="optional-copy"><view class="optional-title">补充装修需求（选填）</view><view class="optional-description">可填写风格、收纳或现场重点确认事项。</view></view>
    <view class="optional-state" style="color: {{primaryColor}}">{{optionalDetailsExpanded ? '收起' : '填写'}}</view>
  </button>

  <view tt:if="{{optionalDetailsExpanded}}" class="optional-fields">
    <view class="field-group">
      <view class="field-label">装修需求</view>
      <textarea class="field-textarea ui-control" aria-label="装修需求" data-field="demand" maxlength="1000" value="{{value.demand}}" placeholder="例如：希望确认柜体和水电范围" disabled="{{submitting}}" bindinput="onInput" />
    </view>
  </view>

  <view class="consent-block"><privacy-consent checked="{{consented}}" company-name="{{companyName}}" primary-color="{{primaryColor}}" primary-text-color="{{primaryTextColor}}" error="{{fieldErrors.consent || ''}}" disabled="{{submitting}}" bindchange="onConsentChange" bindopenpolicy="onOpenPolicy" /></view>
  <button tt:if="{{douyinClueEnabled}}" class="submit-button ui-pressable" hover-class="ui-pressable--pressed" style="background-color: {{primaryColor}}; color: {{primaryTextColor}}" open-type="getPhoneNumber" bindgetphonenumber="onDouyinPhoneNumber" loading="{{submitting}}" disabled="{{submitting}}">{{submitting ? '正在提交' : '授权手机号并提交'}}</button>
  <button tt:else class="submit-button ui-pressable" hover-class="ui-pressable--pressed" style="background-color: {{primaryColor}}; color: {{primaryTextColor}}" form-type="submit" loading="{{submitting}}" disabled="{{submitting}}">{{submitting ? '正在提交' : '提交量房申请'}}</button>
</form>
