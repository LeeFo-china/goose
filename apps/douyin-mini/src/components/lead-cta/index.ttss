.lead-cta { box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 32rpx; padding: 36rpx; border-radius: 24rpx; background: #2c2825; color: #fff; }
.lead-copy { min-width: 0; flex: 1; }
.lead-title { font-size: 32rpx; font-weight: 600; line-height: 1.4; }
.lead-description { max-width: 460rpx; margin-top: 10rpx; color: rgba(255,255,255,.78); font-size: 24rpx; line-height: 1.55; }
.lead-action { box-sizing: border-box; min-width: 220rpx; min-height: 88rpx; flex: none; margin: 0; padding: 0 24rpx; border-radius: 12rpx; color: #fff; font-size: 27rpx; font-weight: 600; line-height: 88rpx; }
.lead-action[disabled] { opacity: .55; }
.lead-action--error { background: #fff; color: #25211e; }
