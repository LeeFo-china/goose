.sms-row { display: flex; gap: 16rpx; }
.sms-input { box-sizing: border-box; min-width: 0; height: 92rpx; flex: 1; padding: 0 24rpx; border: 1rpx solid #d8d1cb; border-radius: 14rpx; background: #fff; color: #25211e; font-size: 27rpx; }
.sms-button { box-sizing: border-box; width: 236rpx; height: 92rpx; margin: 0; padding: 0 12rpx; border: 1rpx solid #b84e2d; border-radius: 14rpx; background: #fff7f3; color: #983d22; font-size: 25rpx; line-height: 90rpx; }
.sms-button[disabled] { border-color: #ddd6d0; background: #f0edeb; color: #958d87; opacity: 1; }
