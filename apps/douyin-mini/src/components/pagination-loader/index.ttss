.pagination { display: flex; min-height: 112rpx; align-items: center; justify-content: center; padding: 12rpx 0; }
.pagination-copy { color: #6d655f; font-size: 24rpx; line-height: 1.5; }
.pagination-action { min-height: 88rpx; margin: 0; padding: 0 28rpx; border-radius: 12rpx; background: transparent; color: #7f351f; font-size: 26rpx; line-height: 88rpx; }
