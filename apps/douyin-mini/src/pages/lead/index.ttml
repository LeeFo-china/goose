<page-skeleton tt:if="{{loading}}" />
<error-state tt:elif="{{error}}" title="咨询服务暂时无法加载" description="请检查网络后重试。" bindretry="load" />
<empty-state tt:elif="{{disabled}}" title="在线咨询暂未开放" description="装修公司当前未开放短信咨询服务。" />
<view tt:else class="page-content lead-page">
  <view class="lead-kicker">免费装修咨询</view>
  <view class="lead-title">说说你家的装修计划</view>
  <view class="lead-description">提交后，由 {{companyName}} 的服务人员与你联系。公开内容浏览不要求提交这些信息。</view>
  <view class="form-block">
    <lead-form value="{{form}}" company-name="{{companyName}}" primary-color="{{primaryColor}}" primary-text-color="{{primaryTextColor}}" phone-ready="{{phoneReady}}" sms-sending="{{smsSending}}" sms-cooldown="{{smsCooldown}}" consented="{{consented}}" submitting="{{submitting}}" bindfieldchange="onFieldChange" bindsendsms="onSendSms" bindconsentchange="onConsentChange" bindopenpolicy="onOpenPolicy" bindsubmit="onSubmit" />
  </view>
  <view tt:if="{{formError}}" class="form-error" role="alert">{{formError}}</view>
  <view class="security-note">验证码仅用于确认本次联系方式。平台不会在客户端读取抖音账号绑定手机号。</view>
  <button tt:if="{{servicePhone}}" class="phone-action" bindtap="onPhoneCall">直接联系装修公司：{{servicePhone}}</button>
</view>
