<page-skeleton tt:if="{{loading}}" />
<error-state tt:elif="{{error}}" title="项目暂时无法查看" description="项目可能已下线，或网络暂时不可用。" bindretry="load" />
<view tt:elif="{{project}}" class="page-content detail-page">
  <view class="detail-heading"><view class="detail-title">{{project.title}}</view><view class="phase-badge" style="border-color: {{primaryColor}}">{{phaseLabel}}</view></view>
  <view class="detail-location">{{project.community || project.city || '区域待定'}}<text tt:if="{{project.district}}"> · {{project.district}}</text></view>
  <view class="gallery-block"><view tt:if="{{images.length}}"><image-gallery items="{{images}}" /></view><empty-state tt:else title="项目图片待更新" description="装修公司尚未发布该项目的公开图片。" /></view>
  <view class="fact-grid"><view class="fact"><view class="fact-label">户型</view><view class="fact-value">{{project.layout || '待完善'}}</view></view><view class="fact"><view class="fact-label">面积</view><view class="fact-value">{{project.area ? project.area + '㎡' : '待完善'}}</view></view><view class="fact"><view class="fact-label">预算区间</view><view class="fact-value">{{project.budget_band || '面议'}}</view></view><view class="fact"><view class="fact-label">装修风格</view><view class="fact-value">{{styleText || '待完善'}}</view></view></view>
  <view class="description-section"><view class="section-title">项目说明</view><view class="description-copy">{{project.description || '该项目的公开说明正在完善，具体方案需结合你的户型与需求沟通。'}}</view></view>
  <view tt:if="{{isInProgress}}" class="progress-section">
    <view class="section-title">施工进度</view>
    <view class="progress-note">只展示装修公司确认公开的施工节点和现场图片。</view>
    <view tt:if="{{progressFirstLoading}}" class="progress-loading"><view class="progress-loading-bar"></view><view class="progress-loading-bar"></view></view>
    <error-state tt:elif="{{progressFirstError}}" title="施工进度加载失败" bindretry="onRetryProgress" />
    <view tt:elif="{{progress.length}}" class="timeline">
      <view tt:for="{{progress}}" tt:key="id" class="timeline-item">
        <view class="timeline-rail"><view class="timeline-dot" style="background: {{primaryColor}}"></view></view>
        <view class="timeline-content"><view class="progress-date">{{item.date}}</view><view class="progress-title">{{item.title}}</view><view tt:if="{{item.images.length}}" class="progress-images"><image-gallery items="{{item.images}}" /></view></view>
      </view>
    </view>
    <empty-state tt:else title="施工记录待更新" description="装修公司尚未发布该项目的公开施工进度。" />
    <pagination-loader tt:if="{{progress.length}}" status="{{progressStatus}}" bindloadmore="onLoadMoreProgress" bindretry="onRetryProgress" />
  </view>
  <view class="update-copy">内容最近更新：{{updatedDate}}</view>
  <view class="detail-cta"><lead-cta primary-color="{{primaryColor}}" bindaction="onLead" /></view>
</view>
