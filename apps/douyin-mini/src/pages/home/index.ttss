.home-page { padding-bottom: 56rpx; }
.home-block { margin-top: 28rpx; }
.home-hero { margin-top: 24rpx; }
.home-section { margin-top: 56rpx; }
.home-tools { margin-top: 28rpx; border-top: 1rpx solid #dddad5; border-bottom: 1rpx solid #dddad5; }
.home-tool-link { box-sizing: border-box; display: flex; width: 100%; min-height: 116rpx; align-items: center; justify-content: space-between; gap: 24rpx; margin: 0; padding: 20rpx 4rpx; background: transparent; color: #191817; text-align: left; line-height: normal; }
.home-tool-link + .home-tool-link { border-top: 1rpx solid #dddad5; }
.home-tool-copy { min-width: 0; flex: 1; }
.home-tool-title { font-size: 28rpx; font-weight: 650; line-height: 1.4; }
.home-tool-description { margin-top: 6rpx; overflow: hidden; color: #625f5b; font-size: 23rpx; line-height: 1.5; text-overflow: ellipsis; white-space: nowrap; }
.home-tool-arrow { width: 40rpx; flex: none; font-size: 40rpx; line-height: 1; text-align: right; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; margin-bottom: 24rpx; }
.section-actions { display: flex; align-items: center; gap: 8rpx; }
.section-link, .text-action, .privacy-link { min-height: 88rpx; margin: 0; padding: 0 8rpx; background: transparent; font-size: 26rpx; line-height: 88rpx; }
.material-list { border-top: 1rpx solid #dddad5; }
.project-list { display: flex; flex-direction: column; gap: 36rpx; }
.metrics-section { margin-top: 52rpx; }
.process-list { margin-top: 22rpx; border-top: 1rpx solid #dddad5; }
.process-item { display: flex; gap: 24rpx; padding: 26rpx 0; border-bottom: 1rpx solid #dddad5; }
.process-index { width: 60rpx; flex: none; font-size: 24rpx; font-weight: 650; }
.process-title { color: #191817; font-size: 28rpx; font-weight: 650; }
.process-description, .process-note, .company-copy, .section-empty { margin-top: 8rpx; color: #625f5b; font-size: 24rpx; line-height: 1.65; }
.process-note { margin-top: 18rpx; font-size: 22rpx; }
.company-section { padding-top: 2rpx; }
.region-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 24rpx; }
.region-tag { padding: 12rpx 18rpx; border-radius: 999rpx; background: #eceae6; color: #625f5b; font-size: 24rpx; }
.section-empty { margin-top: 20rpx; }
.company-name { margin-top: 28rpx; color: #191817; font-size: 28rpx; font-weight: 650; }
.company-copy { margin-top: 12rpx; }
.text-action { margin-top: 8rpx; }
.privacy-link { width: 100%; margin-top: 24rpx; color: #706c67; font-size: 23rpx; text-align: center; }
.material-module-loading { border-top: 1rpx solid #dddad5; }
.material-loading-row { padding: 26rpx 4rpx; border-bottom: 1rpx solid #dddad5; }
.material-loading-bar { width: 72%; height: 24rpx; border-radius: 6rpx; background: #eceae6; }
.material-loading-bar--short { width: 48%; height: 20rpx; margin-top: 16rpx; }
.material-module-error { display: flex; min-height: 88rpx; align-items: center; justify-content: space-between; gap: 20rpx; padding: 18rpx 22rpx; font-size: 23rpx; line-height: 1.55; }
.material-retry { min-width: 104rpx; min-height: 88rpx; margin: 0; padding: 0 16rpx; background: transparent; color: #191817; font-size: 24rpx; line-height: 88rpx; }
