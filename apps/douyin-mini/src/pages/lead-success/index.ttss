@import "../../styles/tokens.ttss";

.success-page { box-sizing: border-box; min-height: 100vh; padding: 112rpx 40rpx 64rpx; background: #f7f6f4; text-align: center; }
.success-page--center { display: flex; align-items: center; justify-content: center; flex-direction: column; color: #625f5b; font-size: 26rpx; }
.success-mark { display: flex; width: 104rpx; height: 104rpx; margin: 0 auto; align-items: center; justify-content: center; border-radius: 52rpx; background: #dfeadf; color: #356044; font-size: 54rpx; font-weight: 600; }
.success-title { margin-top: 36rpx; color: #25211e; font-size: 40rpx; font-weight: 650; }
.success-copy { margin-top: 14rpx; color: #5f5853; font-size: 27rpx; line-height: 1.7; }
.appointment-card { margin-top: 34rpx; padding: 6rpx 24rpx; border: 1rpx solid #d4d0ca; border-radius: 14rpx; background: #fff; text-align: left; }
.detail-row { display: flex; min-width: 0; gap: 24rpx; padding: 22rpx 0; border-bottom: 1rpx solid #eceae6; }
.detail-row:last-child { border-bottom: 0; }
.detail-label { width: 112rpx; flex: none; color: #706c67; font-size: 23rpx; }
.detail-value { min-width: 0; flex: 1; overflow-wrap: anywhere; color: #25211e; font-size: 25rpx; line-height: 1.55; }
.success-note { margin-top: 24rpx; padding: 22rpx; border-radius: 12rpx; background: #eeeae6; color: #625f5b; font-size: 23rpx; line-height: 1.7; text-align: left; }
.budget-button, .home-button, .secondary-button { box-sizing: border-box; width: 100%; min-height: 92rpx; border-radius: 12rpx; font-size: 27rpx; line-height: 92rpx; }
.budget-button { margin-top: 34rpx; border: 1rpx solid #2c2825; background: #fff; color: #2c2825; }
.home-button { margin-top: 18rpx; background: #2c2825; color: #fff; }
.secondary-button { margin-top: 36rpx; background: #2c2825; color: #fff; }
.invalid-title { color: #25211e; font-size: 34rpx; font-weight: 650; }
.invalid-copy { margin-top: 16rpx; color: #706c67; font-size: 24rpx; line-height: 1.7; }
