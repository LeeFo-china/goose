@import "../../styles/tokens.ttss";

.rendering-page { padding-bottom: 48rpx; }
.page-header { padding-top: 8rpx; }
.filter-heading { margin-top: 28rpx; color: #191817; font-size: 26rpx; font-weight: 650; }
.filter-scroll { width: 100%; margin-top: 14rpx; white-space: nowrap; }
.filter-options { display: inline-flex; gap: 12rpx; padding-right: 24rpx; }
.filter-chip { min-height: 72rpx; margin: 0; padding: 0 24rpx; border: 1rpx solid #dddad5; border-radius: 999rpx; background: #fff; color: #403d39; font-size: 24rpx; line-height: 72rpx; }
.rendering-hint { margin-top: 24rpx; color: #625f5b; font-size: 22rpx; line-height: 1.5; }
.rendering-list { display: flex; flex-direction: column; gap: 22rpx; margin-top: 24rpx; }
.rendering-card { display: block; width: 100%; margin: 0; padding: 0; text-align: left; }
.rendering-image { display: block; width: 100%; height: 360rpx; background: #eceae6; }
.rendering-image--empty { display: flex; align-items: center; justify-content: center; color: #625f5b; font-size: 24rpx; }
.rendering-card-body { padding: 22rpx 24rpx 24rpx; }
.rendering-card-title { overflow: hidden; color: #191817; font-size: 30rpx; font-weight: 650; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.rendering-card-meta { display: flex; justify-content: space-between; gap: 16rpx; margin-top: 10rpx; color: #625f5b; font-size: 23rpx; line-height: 1.5; }
.rendering-source { flex: none; color: #403d39; }
.rendering-loading-copy { padding: 40rpx 0; color: #625f5b; font-size: 24rpx; text-align: center; }
.rendering-blocked { margin-top: 36rpx; padding: 24rpx; font-size: 26rpx; line-height: 1.5; }
