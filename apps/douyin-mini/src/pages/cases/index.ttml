<page-skeleton tt:if="{{firstLoading}}" />
<error-state tt:elif="{{firstError}}" bindretry="onRetry" />
<view tt:else class="page-content cases-page">
  <view class="page-header">
    <view class="ui-page-title">项目实景</view>
    <view class="ui-page-description">查看施工中与已完工项目，了解真实空间和施工进展。</view>
  </view>
  <scroll-view scroll-x class="phase-scroll"><view class="phase-options"><button tt:for="{{phaseFilters}}" tt:key="value" class="filter-chip ui-pressable" hover-class="ui-pressable--pressed" style="{{selectedPhase === item.value ? activeFilterStyle : ''}}" data-value="{{item.value}}" bindtap="onSelectPhase">{{item.label}}</button></view></scroll-view>
  <view tt:if="{{items.length}}" class="case-list"><view tt:for="{{items}}" tt:key="id" class="project-card"><view class="project-phase" style="border-color: {{primaryColor}}">{{item.phaseLabel}}</view><case-card item="{{item}}" primary-color="{{primaryColor}}" primary-text-color="{{primaryTextColor}}" bindselect="onProjectSelect" /></view></view>
  <empty-state tt:else title="暂无匹配项目" description="{{hasActiveFilters ? '当前阶段暂无公开项目，可以选择“全部”继续浏览。' : '装修公司尚未发布项目实景，可以稍后再来查看。'}}" />
  <pagination-loader tt:if="{{items.length}}" status="{{paginationStatus}}" bindloadmore="onLoadMore" bindretry="onRetry" />
</view>
