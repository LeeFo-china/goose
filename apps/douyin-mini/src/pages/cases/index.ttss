.cases-page { padding-bottom: 36rpx; }
.page-header { padding: 8rpx 0 4rpx; }
.filters { margin-top: 32rpx; padding: 24rpx 0; border-top: 1rpx solid #dddad5; border-bottom: 1rpx solid #dddad5; }
.filter-heading { display: flex; min-height: 56rpx; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 8rpx; }
.filter-heading-title { color: #191817; font-size: 26rpx; font-weight: 650; }
.filter-clear { min-height: 56rpx; margin: 0; padding: 0 8rpx; background: transparent; font-size: 23rpx; line-height: 56rpx; }
.filter-row { display: flex; min-height: 96rpx; align-items: center; }
.filter-label { width: 72rpx; flex: none; color: #625f5b; font-size: 23rpx; }
.filter-scroll { min-width: 0; flex: 1; white-space: nowrap; }
.filter-options { display: inline-flex; gap: 12rpx; padding-right: 24rpx; }
.filter-chip { min-width: 104rpx; min-height: 88rpx; margin: 0; padding: 0 24rpx; border: 1rpx solid #dddad5; border-radius: 44rpx; background: #fff; color: #625f5b; font-size: 24rpx; line-height: 86rpx; }
.case-list { display: flex; flex-direction: column; gap: 24rpx; margin-top: 28rpx; }
