@import "../../styles/tokens.ttss";

.customer-login-page {
  box-sizing: border-box;
  max-width: 750rpx;
  min-height: 100vh;
  margin: 0 auto;
  padding-top: 24rpx;
  padding-bottom: 64rpx;
}

.welcome {
  box-sizing: border-box;
  min-height: 276rpx;
  padding: 30rpx;
  border-radius: 16rpx;
}

.brand-row { display: flex; min-width: 0; align-items: center; gap: 16rpx; }
.brand-mark { display: flex; width: 64rpx; height: 64rpx; flex: none; align-items: center; justify-content: center; overflow: hidden; border-radius: 12rpx; background: #fff; }
.brand-logo { width: 64rpx; height: 64rpx; }
.brand-fallback { font-size: 28rpx; font-weight: 700; line-height: 64rpx; }
.brand-name { overflow: hidden; font-size: 25rpx; font-weight: 600; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.welcome-title { margin-top: 34rpx; font-size: 40rpx; font-weight: 700; line-height: 1.3; }
.welcome-description { margin-top: 14rpx; font-size: 25rpx; line-height: 1.6; opacity: .82; }

.login-section,
.candidate-section {
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 30rpx;
  border: 1rpx solid #e4e1dd;
  border-radius: 16rpx;
  background: #fff;
}

.primary-action,
.verify-action {
  box-sizing: border-box;
  width: 100%;
  min-height: 94rpx;
  margin: 0;
  border-radius: 16rpx;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 94rpx;
}

.primary-action[disabled],
.verify-action[disabled] { opacity: .6; }

.method-divider { display: flex; align-items: center; gap: 18rpx; margin: 30rpx 0 8rpx; }
.divider-line { height: 1rpx; flex: 1; background: #e8e5e1; }
.divider-label { flex: none; color: #85817c; font-size: 22rpx; line-height: 1.5; }

.sms-toggle {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-height: 78rpx;
  align-items: center;
  justify-content: space-between;
  margin: 0;
  padding: 0 4rpx;
  background: transparent;
  color: #353330;
  font-size: 26rpx;
  line-height: 78rpx;
  text-align: left;
}

.sms-toggle[disabled] { color: #85817c; opacity: 1; }
.toggle-symbol { width: 40rpx; color: #706c67; font-size: 32rpx; font-weight: 400; text-align: center; }

.sms-form {
  padding-top: 24rpx;
  border-top: 1rpx solid #ece9e5;
  animation: reveal-form .18s ease-out both;
}

.field-group + .field-group { margin-top: 24rpx; }
.field-label { margin-bottom: 12rpx; color: #353330; font-size: 24rpx; font-weight: 600; line-height: 1.4; }
.field-input { box-sizing: border-box; width: 100%; height: 88rpx; padding: 0 22rpx; font-size: 26rpx; }
.field-input[disabled] { background: #f3f1ee; color: #706c67; }
.field-error { margin-top: 9rpx; color: #a8251a; font-size: 22rpx; line-height: 1.5; }
.sms-row { display: flex; align-items: center; gap: 14rpx; }
.code-input { min-width: 0; flex: 1; }
.sms-send { box-sizing: border-box; width: 220rpx; height: 88rpx; margin: 0; padding: 0 8rpx; border: 1rpx solid #191817; border-radius: 14rpx; background: #fff; color: #191817; font-size: 23rpx; line-height: 86rpx; }
.sms-send[disabled] { border-color: #dedbd6; background: #f0eeeb; color: #85817c; opacity: 1; }
.verify-action { margin-top: 28rpx; }

.inline-error,
.form-notice { margin-top: 18rpx; padding: 18rpx 20rpx; border-radius: 12rpx; font-size: 23rpx; line-height: 1.5; }
.inline-error { background: #fdecea; color: #8e1b13; }
.form-notice { background: #edf6f0; color: #23643a; }

.section-kicker { color: #706c67; font-size: 22rpx; line-height: 1.5; }
.section-title { margin-top: 8rpx; color: #191817; font-size: 34rpx; font-weight: 700; line-height: 1.35; }
.section-description { margin-top: 10rpx; color: #706c67; font-size: 24rpx; line-height: 1.5; }
.candidate-item { display: flex; box-sizing: border-box; width: 100%; min-height: 110rpx; align-items: center; margin: 18rpx 0 0; padding: 20rpx 22rpx; border: 1rpx solid #e2dfda; border-radius: 14rpx; background: #fff; color: #191817; text-align: left; }
.candidate-copy { min-width: 0; flex: 1; }
.candidate-title { overflow: hidden; font-size: 27rpx; font-weight: 650; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
.candidate-subtitle { overflow: hidden; margin-top: 5rpx; color: #706c67; font-size: 23rpx; line-height: 1.45; text-overflow: ellipsis; white-space: nowrap; }
.candidate-arrow { width: 38rpx; flex: none; color: #85817c; font-size: 36rpx; font-weight: 400; text-align: right; }
.candidate-item[disabled] { opacity: .65; }

.privacy-note { margin-top: 24rpx; color: #85817c; font-size: 22rpx; line-height: 1.6; text-align: center; }

@keyframes reveal-form {
  from { opacity: 0; transform: translateY(-8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .sms-form { animation: none; }
}
