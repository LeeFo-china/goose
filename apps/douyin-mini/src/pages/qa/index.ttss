.qa-page { padding: 24rpx 24rpx 56rpx; }
.qa-hero { padding: 36rpx 32rpx; }
.qa-kicker { color: #706c67; font-size: 23rpx; font-weight: 650; }
.qa-title { margin-top: 10rpx; color: #191817; font-size: 38rpx; font-weight: 750; line-height: 1.3; }
.qa-copy, .qa-disclaimer { margin-top: 14rpx; color: #625f5b; font-size: 24rpx; line-height: 1.65; }
.qa-section { margin-top: 24rpx; padding: 32rpx; }
.qa-section-title { color: #191817; font-size: 28rpx; font-weight: 700; }
.preset-list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 22rpx; }
.preset-button { min-height: 88rpx; margin: 0; padding: 20rpx 24rpx; border-radius: 18rpx; background: #f5f5f3; color: #191817; font-size: 26rpx; line-height: 1.45; text-align: left; }
.question-input { box-sizing: border-box; width: 100%; min-height: 160rpx; margin-top: 22rpx; padding: 24rpx; border-radius: 18rpx; background: #f5f5f3; color: #191817; font-size: 26rpx; line-height: 1.55; }
.submit-button, .lead-button { width: 100%; min-height: 88rpx; margin-top: 24rpx; border-radius: 20rpx; background: #191817; color: #fff; font-size: 28rpx; font-weight: 650; line-height: 88rpx; }
.result-card { border: 1rpx solid #dddad5; }
.answer-list { display: flex; flex-direction: column; gap: 16rpx; margin-top: 22rpx; }
.answer-item { padding: 22rpx 24rpx; border-radius: 18rpx; background: #f5f5f3; color: #191817; font-size: 25rpx; line-height: 1.6; }
.qa-disclaimer { font-size: 22rpx; }
.follow-title { margin-top: 28rpx; }
