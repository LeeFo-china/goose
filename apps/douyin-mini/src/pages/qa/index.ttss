.qa-page {
  min-height: 100vh;
  padding: 28rpx 24rpx calc(180rpx + env(safe-area-inset-bottom));
  background: #f7f5f2;
  box-sizing: border-box;
}

.qa-header {
  padding: 10rpx 4rpx 26rpx;
}

.qa-title {
  color: #191817;
  font-size: 40rpx;
  font-weight: 760;
  line-height: 1.25;
}

.qa-subtitle {
  margin-top: 12rpx;
  color: #625f5b;
  font-size: 24rpx;
  line-height: 1.55;
}

.qa-chat {
  height: calc(100vh - 250rpx);
}

.preset-panel,
.error-panel,
.suggestion-panel {
  padding: 28rpx;
  border: 1rpx solid #e2ded8;
  border-radius: 24rpx;
  background: #fff;
}

.preset-title,
.suggestion-title,
.error-title {
  color: #191817;
  font-size: 27rpx;
  font-weight: 700;
}

.preset-button,
.suggestion-button {
  display: block;
  width: 100%;
  min-height: 84rpx;
  margin: 18rpx 0 0;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: #f3f0ec;
  color: #25221f;
  font-size: 26rpx;
  line-height: 1.45;
  text-align: left;
}

.message-list {
  padding-bottom: 20rpx;
}

.message {
  display: flex;
  margin-top: 20rpx;
}

.message--user {
  justify-content: flex-end;
}

.message--assistant {
  justify-content: flex-start;
}

.message-bubble {
  max-width: 600rpx;
  padding: 22rpx 26rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  font-size: 27rpx;
  line-height: 1.62;
  white-space: pre-line;
}

.message--user .message-bubble {
  border-bottom-right-radius: 8rpx;
  background: #191817;
  color: #fff;
}

.message--assistant .message-bubble {
  border: 1rpx solid #e2ded8;
  border-bottom-left-radius: 8rpx;
  background: #fff;
  color: #25221f;
}

.message-text {
  white-space: pre-line;
}

.typing-dot {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 78rpx;
  min-height: 32rpx;
}

.typing-dot__item {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #8a8580;
  animation: qaTypingPulse 1s ease-in-out infinite;
}

.typing-dot__item--two {
  animation-delay: 0.16s;
}

.typing-dot__item--three {
  animation-delay: 0.32s;
}

.qa-disclaimer,
.error-copy {
  margin-top: 18rpx;
  color: #706c67;
  font-size: 23rpx;
  line-height: 1.6;
}

.suggestion-panel {
  margin-top: 22rpx;
}

.lead-button {
  width: 100%;
  min-height: 86rpx;
  margin-top: 22rpx;
  border-radius: 18rpx;
  background: #191817;
  color: #fff;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 86rpx;
}

.qa-composer {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 20rpx 24rpx calc(34rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e2ded8;
  background: #fff;
  box-shadow: 0 -6rpx 20rpx rgba(25, 24, 23, 0.06);
  box-sizing: border-box;
}

.question-input {
  flex: 1;
  min-height: 80rpx;
  max-height: 160rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #f3f0ec;
  color: #191817;
  font-size: 26rpx;
  line-height: 1.45;
  box-sizing: border-box;
}

.submit-button {
  flex: 0 0 126rpx;
  min-height: 80rpx;
  margin: 0;
  border-radius: 20rpx;
  background: #191817;
  color: #fff;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 80rpx;
}

@keyframes qaTypingPulse {
  0%,
  80%,
  100% {
    opacity: 0.35;
    transform: translateY(0);
  }
  40% {
    opacity: 1;
    transform: translateY(-4rpx);
  }
}
