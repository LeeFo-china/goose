<view class="qa-page">
  <view class="qa-header">
    <view class="qa-title">装修问题助手</view>
    <view class="qa-subtitle">问预算、旧房、局部改造和量房准备，不填写手机号和详细地址。</view>
  </view>

  <scroll-view class="qa-chat" scroll-y>
    <view tt:if="{{!stream && status !== 'failed'}}" class="preset-panel">
      <view class="preset-title">可以这样问</view>
      <button tt:for="{{presetQuestions}}" tt:key="*this" class="preset-button ui-pressable" hover-class="ui-pressable--pressed" data-question="{{item}}" bindtap="onPresetTap">{{item}}</button>
    </view>

    <view tt:if="{{stream}}" class="message-list" role="status">
      <view tt:for="{{stream.messages}}" tt:key="id" class="message message--{{item.role}}">
        <view class="message-bubble">
          <view tt:if="{{item.text}}" class="message-text">{{item.text}}</view>
          <view tt:if="{{item.typing}}" class="typing-dot">
            <view class="typing-dot__item typing-dot__item--one"></view>
            <view class="typing-dot__item typing-dot__item--two"></view>
            <view class="typing-dot__item typing-dot__item--three"></view>
          </view>
        </view>
      </view>
      <view tt:if="{{stream.disclaimer}}" class="qa-disclaimer">{{stream.disclaimer}}</view>
      <view tt:if="{{stream.suggestedQuestions.length}}" class="suggestion-panel">
        <view class="suggestion-title">继续了解</view>
        <button tt:for="{{stream.suggestedQuestions}}" tt:key="*this" class="suggestion-button ui-pressable" hover-class="ui-pressable--pressed" data-question="{{item}}" bindtap="onSuggestedQuestionTap">{{item}}</button>
        <button class="lead-button ui-pressable" hover-class="ui-pressable--pressed" bindtap="onBookMeasurement">预约免费量房</button>
      </view>
    </view>

    <view tt:if="{{status === 'failed'}}" class="error-panel" role="status">
      <view class="error-title">暂时无法回答</view>
      <view class="error-copy">{{errorMessage}}</view>
      <button class="lead-button ui-pressable" hover-class="ui-pressable--pressed" bindtap="onBookMeasurement">预约免费量房</button>
    </view>
  </scroll-view>

  <form class="qa-composer" bindsubmit="onSubmit">
    <textarea class="question-input" name="question" value="{{question}}" maxlength="120" placeholder="输入装修问题" placeholder-style="color: #8A8580;" auto-height show-confirm-bar="{{false}}" confirm-type="send" bindinput="onQuestionInput" bindconfirm="onQuestionConfirm" />
    <button class="submit-button ui-pressable" hover-class="ui-pressable--pressed" disabled="{{status === 'submitting'}}" form-type="submit">
      <view tt:if="{{status === 'submitting'}}" class="submit-button__spinner"></view>
      <view class="submit-button__label">发送</view>
    </button>
  </form>
</view>
