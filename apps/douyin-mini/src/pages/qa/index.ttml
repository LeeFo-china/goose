<view class="qa-page">
  <view class="qa-hero ui-card">
    <view class="qa-kicker">装修问题助手</view>
    <view class="qa-title">把装修疑问先问清楚</view>
    <view class="qa-copy">适合咨询预算准备、旧房翻新、局部装修和量房准备。请不要填写手机号、详细地址或微信号。</view>
  </view>

  <view class="qa-section ui-card">
    <view class="qa-section-title">常见问题</view>
    <view class="preset-list">
      <button tt:for="{{presetQuestions}}" tt:key="*this" class="preset-button ui-pressable" hover-class="ui-pressable--pressed" data-question="{{item}}" bindtap="onPresetTap">{{item}}</button>
    </view>
  </view>

  <view class="qa-section ui-card">
    <view class="qa-section-title">输入你的问题</view>
    <textarea class="question-input" value="{{question}}" maxlength="120" placeholder="例如：旧房翻新要先看哪些地方？" placeholder-style="color: #706C67;" auto-height bindinput="onQuestionInput" />
    <button class="submit-button ui-pressable" hover-class="ui-pressable--pressed" loading="{{status === 'submitting'}}" disabled="{{status === 'submitting'}}" bindtap="onSubmit">提交问题</button>
  </view>

  <view tt:if="{{status === 'answered' && answer}}" class="qa-section result-card ui-card" role="status">
    <view class="qa-section-title">参考建议</view>
    <view class="answer-list">
      <view tt:for="{{answer.answer_points}}" tt:key="*this" class="answer-item">{{item}}</view>
    </view>
    <view class="qa-disclaimer">{{answer.disclaimer}}</view>
    <view tt:if="{{answer.suggested_questions.length}}" class="qa-section-title follow-title">你还可以问</view>
    <view class="preset-list">
      <button tt:for="{{answer.suggested_questions}}" tt:key="*this" class="preset-button ui-pressable" hover-class="ui-pressable--pressed" data-question="{{item}}" bindtap="onSuggestedQuestionTap">{{item}}</button>
    </view>
    <button class="lead-button ui-pressable" hover-class="ui-pressable--pressed" bindtap="onBookMeasurement">预约免费量房</button>
  </view>

  <view tt:elif="{{status === 'failed'}}" class="qa-section ui-card" role="status">
    <view class="qa-section-title">暂时无法回答</view>
    <view class="qa-copy">{{errorMessage}}</view>
    <button class="lead-button ui-pressable" hover-class="ui-pressable--pressed" bindtap="onBookMeasurement">预约免费量房</button>
  </view>
</view>
