.detail-page { padding-bottom: 224rpx; }
.detail-kicker, .section-kicker { color: #9a4124; font-size: 22rpx; font-weight: 600; letter-spacing: 2rpx; }
.detail-title { margin-top: 10rpx; color: #25211e; font-size: 42rpx; font-weight: 600; line-height: 1.35; }
.location-copy { margin-top: 14rpx; color: #665f5a; font-size: 25rpx; }
.fact-row { display: flex; margin-top: 36rpx; border-top: 1rpx solid #dfdad5; border-left: 1rpx solid #dfdad5; }
.fact { box-sizing: border-box; width: 50%; min-height: 144rpx; padding: 26rpx; border-right: 1rpx solid #dfdad5; border-bottom: 1rpx solid #dfdad5; background: #fff; }
.fact-label { color: #756d67; font-size: 22rpx; }
.fact-value { margin-top: 10rpx; color: #25211e; font-size: 27rpx; font-weight: 600; line-height: 1.45; }
.status-value { color: #356044; }
.progress-section { margin-top: 58rpx; }
.section-title { margin-top: 8rpx; color: #25211e; font-size: 34rpx; font-weight: 600; }
.privacy-note { margin-top: 20rpx; color: #716963; font-size: 23rpx; line-height: 1.6; }
.timeline { margin-top: 34rpx; }
.timeline-item { display: flex; }
.timeline-rail { position: relative; width: 48rpx; flex: none; }
.timeline-rail::after { position: absolute; top: 24rpx; bottom: 0; left: 11rpx; width: 2rpx; background: #d9d3ce; content: ""; }
.timeline-item:last-child .timeline-rail::after { display: none; }
.timeline-dot { position: relative; z-index: 1; width: 22rpx; height: 22rpx; margin-top: 6rpx; border: 6rpx solid #f0d7cc; border-radius: 50%; background: #a84324; }
.timeline-content { min-width: 0; flex: 1; padding-bottom: 48rpx; }
.progress-date { color: #827a74; font-size: 22rpx; }
.progress-title { margin-top: 8rpx; color: #25211e; font-size: 30rpx; font-weight: 600; }
.progress-images { margin-top: 22rpx; }
.progress-loading { margin-top: 32rpx; }
.progress-loading-bar { height: 160rpx; margin-top: 18rpx; border-radius: 18rpx; background: #e8e4df; animation: progress-pulse 1.4s ease-in-out infinite; }
.update-copy { margin-top: 30rpx; color: #827a74; font-size: 22rpx; }
.detail-cta { position: fixed; right: 0; bottom: 0; left: 0; z-index: 5; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background: rgba(247,246,244,.96); }
@keyframes progress-pulse { 50% { opacity: .52; } }
@media (prefers-reduced-motion: reduce) { .progress-loading-bar { animation: none; opacity: .65; } }
