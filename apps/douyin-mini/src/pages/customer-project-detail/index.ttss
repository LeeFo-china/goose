.customer-project-detail-page { padding-bottom: 64rpx; }
.project-header { padding-bottom: 28rpx; border-bottom: 1rpx solid #dddad5; }
.current-node { display: inline-flex; margin-top: 18rpx; padding: 8rpx 14rpx; border-radius: 999rpx; background: #eceae6; color: #191817; font-size: 22rpx; }
.logs-title { margin-top: 32rpx; }
.log-list { display: flex; flex-direction: column; gap: 24rpx; margin-top: 20rpx; }
.log-item { padding: 28rpx; }
.log-meta { color: #191817; font-size: 26rpx; font-weight: 650; }
.log-content { margin-top: 14rpx; color: #37332f; font-size: 26rpx; line-height: 1.65; }
.log-images { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-top: 18rpx; }
.log-image { width: 100%; height: 150rpx; border-radius: 8rpx; background: #eceae6; }
.log-footer { margin-top: 16rpx; color: #706c67; font-size: 22rpx; }
