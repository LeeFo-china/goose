@import "../../styles/tokens.ttss";

.materials-page { padding-bottom: 48rpx; }
.materials-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; padding-top: 8rpx; }
.mine-action { min-width: 152rpx; min-height: 88rpx; margin: 0; padding: 0 12rpx; background: transparent; font-size: 26rpx; font-weight: 650; line-height: 88rpx; }
.search-input { width: 100%; height: 88rpx; margin-top: 28rpx; padding: 0 24rpx; font-size: 26rpx; }
.material-list { display: flex; flex-direction: column; gap: 20rpx; margin-top: 28rpx; }
