@import "./styles/tokens.ttss";

page {
  min-height: 100%;
  background: #f5f5f3;
  color: #191817;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

button {
  font-family: inherit;
}

button::after {
  border: 0;
}

.page-content {
  box-sizing: border-box;
  width: 100%;
  padding: 32rpx;
}
